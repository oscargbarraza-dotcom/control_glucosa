# Copiar a %LOCALAPPDATA%\glucosa\.env (fuera de OneDrive) y completar. Este archivo
# de ejemplo no contiene valores reales; el .env real nunca se versiona.

# Proyecto Firebase compartido con la app Android SeguimientoGlucosa.
GLUCOSA_FIREBASE_PROJECT_ID=seguimiento-glucosa

# API key pública de la app web de Firebase registrada para Windows
# (Consola de Firebase > Configuración del proyecto > Tus apps > Web).
# Es un identificador de cliente, no una credencial administrativa.
GLUCOSA_FIREBASE_API_KEY=

# RUTA del JSON del cliente OAuth "Aplicación de escritorio" descargado de Google
# Cloud. Se lee directamente de ese archivo: NO copies client_id ni client_secret
# a este .env. El archivo debe estar fuera de OneDrive y fuera del proyecto.
# Ejemplo: %LOCALAPPDATA%\glucosa\secrets\oauth_client.json
GLUCOSA_OAUTH_CLIENT_FILE=
