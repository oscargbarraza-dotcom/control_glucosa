rules_version = '2';

// Reglas de seguridad para el respaldo/restauración en la nube
// (roadmap punto 14). Cada usuario autenticado solo puede leer y
// escribir su propio documento de respaldo, identificado por su uid.
// Nadie puede acceder al respaldo de otro usuario, ni usuarios no
// autenticados acceder a ningún dato.
service cloud.firestore {
  match /databases/{database}/documents {
    match /backups/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
