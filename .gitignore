# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Assets gráficos generados para la ficha de Google Play (ícono
# 512x512 + gráfico destacado 1024x500). Regenerables con
# `python tool/generate_play_store_assets.py`; su único destino es la
# subida manual a Play Console (ver GOOGLE_PLAY_LISTING.md, sección 0).
/store_assets/

# Capturas de pantalla para la ficha de Google Play (incluye
# Capturas/play_store/, versión corregida a relación de aspecto 2:1
# generada por `python tool/fix_screenshot_aspect_ratio.py`; ver
# GOOGLE_PLAY_LISTING.md, sección 6). Nunca se versionan: contienen
# capturas de la UI real con datos de ejemplo y su único destino es
# la subida manual a Play Console.
/Capturas/

# Firebase (proyecto "seguimiento-glucosa")
# Nota: lib/firebase_options.dart, android/app/google-services.json y
# ios/Runner/GoogleService-Info.plist SÍ se versionan intencionalmente.
# Son identificadores de cliente (no secretos de backend) y la práctica
# oficial de FlutterFire recomienda incluirlos en el control de versiones:
# https://firebase.google.com/docs/flutter/setup
# Si en el futuro se usan credenciales de servidor (p.ej. Service Account
# JSON para Cloud Functions/Admin SDK), SÍ deben ignorarse aquí:
*serviceAccountKey.json
.firebase/
